{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/form-field/form-field.vue.twig' -%}

{%- block vue_config -%}
    {{ parent() }}
    {{ trans_js(render_pass, 'WexampleSymfonyMediaDsBundle.components.media-picker.media-picker::*') }}
{%- endblock -%}

{%- block field_control -%}
    <div class="media-picker">
        {#- The ids the form submits. -#}
        <input type="hidden" :name="name || null" :id="resolvedId" :value="value">

        <ul v-if="items.length" class="file-chips media-picker--items">
            <li v-for="item in items" :key="item.id" class="file-chip">
                <img v-if="item.thumbnailUrl" class="file-chip--media" :src="item.thumbnailUrl" alt="">
                <span v-else class="file-chip--icon" v-html="renderIcon('ph:bold/file')"></span>
                <a class="file-chip--name" :href="item.url" target="_blank" rel="noopener" :title="item.name">[[ item.name ]]</a>
                <button type="button"
                        class="button button--flat button--compact file-chip--remove"
                        :disabled="isDisabled ? true : null"
                        :aria-label="t('remove')"
                        @click="remove(item)">&times;</button>
            </li>
        </ul>

        <button type="button"
                class="button button--compact media-picker--open"
                :disabled="isDisabled ? true : null"
                @click="openLibrary">
            <span v-html="renderIcon('ph:bold/images')"></span>
            <span>[[ items.length && !multiple ? t('replace') : t('pick') ]]</span>
        </button>
    </div>
{%- endblock -%}
