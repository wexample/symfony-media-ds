{
  "name": "wexample/symfony-media-ds",
  "description": "Design-system side of symfony-media: the library page, browsed, uploaded into and arranged, and a form field picking media from it",
  "version": "3.0.8",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyMediaDs\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyMediaDs\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "symfony/form": "^7.4 || ^8.0",
    "wexample/symfony-design-system": ">=39.0.3",
    "wexample/symfony-helpers": ">=18.0.2",
    "wexample/symfony-loader": ">=25.3.0",
    "wexample/symfony-media": ">=6.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13",
    "wexample/symfony-testing": ">=2.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}